{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://oiwckpfrhxsuyilmkxvp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "clipra-mcp",
      "version": "0.1.0",
      "title": "Clipra"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List my Clipra projects",
        "description": "List the signed-in user's Clipra projects (generated clip sets from uploaded videos), newest first. Returns id, video name, created date, and clip count.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Max projects to return (1-100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get Clipra project details",
        "description": "Fetch a single Clipra project by id for the signed-in user, including transcript, viral moments, and the generated clips array (each with title, score, and URL).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Project UUID from list_projects."
            }
          },
          "required": [
            "project_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_usage",
        "title": "Get my Clipra usage & plan",
        "description": "Return the signed-in user's Clipra plan, monthly minutes allowance, minutes used, minutes remaining, and cycle start date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
